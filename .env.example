# Kopiraj u .env i popuni stvarnim vrijednostima.
# .env NIKAD ne commit-aj (gitignored).

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=               # generiraj jak password, npr. `openssl rand -base64 32`

# ─── ClickHouse ─────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=rag
CLICKHOUSE_USER=rag_user
CLICKHOUSE_PASSWORD=             # generiraj jak password

# ─── Embedder service ───────────────────────────────────────────
EMBEDDER_HOST=embedder
EMBEDDER_PORT=8000
EMBEDDER_MODEL=BAAI/bge-m3       # alternative: intfloat/multilingual-e5-large
EMBEDDER_DEVICE=cpu              # cpu | cuda | mps

# ─── Reranker service (Faza 2) ──────────────────────────────────
RERANKER_HOST=reranker
RERANKER_PORT=8001
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── MCP server ─────────────────────────────────────────────────
MCP_PORT=3000
MCP_AUTH_MODE=apikey             # apikey | oauth (Faza 4)
MCP_API_KEY=                     # za AUTH_MODE=apikey; generiraj sigurni ključ

# Admin dashboard / API (opcionalno). Bez ovoga /admin* vraća 404 (disabled).
# Generiraj: openssl rand -base64 32 | tr -d '/=+' | cut -c1-32
ADMIN_API_KEY=

# Rate limits (po OAuth client_id-u, sliding window, in-memory).
# static-api-key je exempt. 429 + Retry-After kad se probije.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# OAuth GC cron — periodic cleanup expired tokens + audit retention.
# Pokreće se in-process, prvi run 60s nakon starta.
OAUTH_GC_INTERVAL_HOURS=24
OAUTH_GC_RETENTION_DAYS=90

# ─── LLM provider za generaciju (cijeli odgovor) ────────────────
# Vrijednost: vertex | claude | openai
LLM_PROVIDER=vertex

# Vertex AI (default)
VERTEX_PROJECT=domovina-sync-ms
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Claude API (alt)
# ANTHROPIC_API_KEY=

# OpenAI (alt)
# OPENAI_API_KEY=

# ─── Podaci (lokalni mount sa fetch.domovina.tv outputa) ────────
# Putanja gdje su *.rag_combined.jsonl i *.embeddings.{model}.json fajlovi
DATA_SOURCE_DIR=/path/to/fetch.domovina.tv/storage/output

# Alternativa: R2 CDN (read-only public)
DATA_R2_BASE_URL=https://cdn.domovina.ai/data

# ─── Redis (rate limiting + OAuth state, Faza 4) ────────────────
# REDIS_URL=redis://redis:6379
