# Cloudflare Pages headers — apex domovina.link
# https://developers.cloudflare.com/pages/configuration/headers/

# Ikone: dozvoli cross-origin (Google faviconV2 scraper, OG cards) + agresivan cache
/favicon.ico
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/icon.svg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/icon-192.png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/icon-512.png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/manifest.json
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# HTML: kratki cache da promjene brzo dolaze do korisnika
/*.html
  Cache-Control: public, max-age=300

/
  Cache-Control: public, max-age=300
