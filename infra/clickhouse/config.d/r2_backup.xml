<clickhouse>
  <!--
    R2 backup disk za BACKUP/RESTORE TABLE komande.
    Secrets se učitavaju iz container env varijabli (R2_ENDPOINT_URL,
    R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) — vidi docker-compose.yml.

    Vidi: docs/cloud_deployment_plan.md §Faza 3.
  -->
  <storage_configuration>
    <disks>
      <r2_backup>
        <type>s3</type>
        <endpoint from_env="R2_ENDPOINT_URL"/>
        <access_key_id from_env="R2_ACCESS_KEY_ID"/>
        <secret_access_key from_env="R2_SECRET_ACCESS_KEY"/>
        <region>auto</region>
        <send_metadata>true</send_metadata>
      </r2_backup>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>r2_backup</allowed_disk>
    <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
  </backups>
</clickhouse>
